# Local test-account credentials; never commit or share this file.
NOON_EMAIL=your_test_email@example.com
NOON_PASSWORD=your_test_password
# automatic | manual | disabled. Manual never types/submits credentials.
NOON_LOGIN_MODE=automatic
# 1 permits human CAPTCHA/OTP completion after one automatic submission.
NOON_MANUAL_AUTH=0
# direct | root | search. No CAPTCHA is solved automatically.
NOON_LOGIN_ENTRY=direct
# Optional exact HTTPS www.noon.com/egypt-ar/<product>/<SKU>/p/ URL.
NOON_PRODUCT_URL=
# Real address saving is explicit opt-in. Default is form preview only.
NOON_SAVE_LOCATION=0
# Required for saving: an explicit Egyptian test contact number.
NOON_TEST_PHONE=
# Optional private original name for recovering an interrupted earlier run.
NOON_PROFILE_RESTORE_NAME=
# Diagnostic only; not an established fix for current live connectivity.
NOON_DISABLE_HTTP2=0
